{
  "name": "matisa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "postinstall": "chmod +x node_modules/.pnpm/node-pty*/node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "typecheck": "tsc -b",
    "engine": "node --import tsx apps/engine/src/main.ts",
    "cli": "node --import tsx apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "esbuild"
    ]
  }
}
